# Self-hosted Ollama AI overlay values for docker-compose.ollama-ai.example.yml

# Ollama exposes an OpenAI-compatible API at /v1. The key is not validated by
# Ollama today, but KeepTally expects one to mark AI as configured.
OLLAMA_OPENAI_API_KEY=ollama-local

# Small CPU-friendly starter model. Pull it before testing KeepTally AI calls:
#   docker compose -f docker-compose.vps.example.yml -f docker-compose.ollama-ai.example.yml --env-file .env.production --env-file .env.ai exec ollama ollama pull qwen2.5:3b
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_COMMAND_MODEL=qwen2.5:3b
OLLAMA_VOICE_PARSE_MODEL=qwen2.5:3b
OLLAMA_AGENT_MODEL=qwen2.5:3b

# Optional admin UI for local model testing.
OPEN_WEBUI_PORT=8088

# Optional workflow automation engine.
N8N_PORT=5678
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-a-long-random-n8n-secret
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/Phoenix
