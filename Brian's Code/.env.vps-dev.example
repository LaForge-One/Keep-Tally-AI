NODE_ENV=development
PORT=3000
KEEP_TALLY_DEV_HOST_PORT=3100

# Use a separate dev database. Do not point dev at keeptally_test.
DATABASE_URL=postgresql://keeptally_dev:CHANGE_ME_DEV_DB_PASSWORD@host.docker.internal:5432/keeptally_dev

# Use the exact browser origin for the dev lane.
# Examples:
# CORS_ORIGIN=https://dev.keeptally.ai
# CORS_ORIGIN=http://2.25.143.61:3100
CORS_ORIGIN=https://dev.keeptally.ai

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_DEV_SECRET_AT_LEAST_32_CHARS

AUTH_COOKIE_SECURE=true
TRUST_PROXY=true
WEB_DIST_DIR=/app/artifacts/keep-tally/dist/public

# OpenAI-compatible AI settings. Use OpenAI for dev unless testing LocalAI specifically.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=CHANGE_ME_OPENAI_OR_COMPATIBLE_KEY
AI_TEXT_MODEL=gpt-4o-mini
AI_AGENT_MODEL=gpt-4o-mini
AI_VOICE_PARSE_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_TTS_MODEL=gpt-4o-mini-tts
AI_TTS_VOICE=nova
AI_TTS_INSTRUCTIONS=Use a smooth, soft, feminine-presenting voice with a warm and reassuring tone. Sound natural and human, not robotic or announcer-like. Use gentle pacing, light upward inflection, and clear inventory-friendly diction. Keep responses brief, calm, and easy to understand for a busy inventory operator.

VITE_VOICE_COUNT_TTS_ENABLED=true
VITE_VOICE_COUNT_CONFIRMATION_AUDIO_ENABLED=true
VITE_MOBILE_SCANNER_V2_ENABLED=true

# Dev-only seed/login bootstrap. Change after first login.
INITIAL_ADMIN_PASSWORD=admin1234
