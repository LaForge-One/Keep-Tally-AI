# Self-hosted AI overlay values for docker-compose.ai.example.yml

# LocalAI acts as KeepTally's OpenAI-compatible API.
LOCALAI_API_KEY=replace-with-a-local-random-secret
LOCALAI_TEXT_MODEL=local-llm
LOCALAI_COMMAND_MODEL=local-llm
LOCALAI_VOICE_PARSE_MODEL=local-llm
LOCALAI_AGENT_MODEL=local-llm
LOCALAI_THREADS=4
LOCALAI_CONTEXT_SIZE=2048
LOCALAI_DEBUG=false

# Optional admin UI for local model testing.
OPEN_WEBUI_PORT=8088

# Optional workflow automation engine.
N8N_PORT=5678
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-a-long-random-n8n-secret
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/Phoenix
