{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent:$npm_execpath\" in pnpm/*|*:*/pnpm*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "node scripts/dev-single.mjs",
    "health": "node scripts/dev-health.mjs",
    "status": "node scripts/dev-status.mjs",
    "smoke": "node scripts/dev-smoke.mjs",
    "audit:dev": "node scripts/vps-dev-surgical-audit.mjs",
    "workflow:test": "node scripts/dev-workflow-test.mjs",
    "test:voice-count": "corepack pnpm --filter @workspace/scripts run test:voice-count",
    "test:warehouse-voice-add-item": "corepack pnpm --filter @workspace/scripts run test:warehouse-voice-add-item",
    "test:mobile-scanner-risks": "corepack pnpm --filter @workspace/scripts run test:mobile-scanner-risks",
    "deploy:preflight": "corepack pnpm --filter @workspace/scripts run deploy:preflight",
    "dev:reset-admin": "corepack pnpm --filter @workspace/scripts run reset-admin-password",
    "build": "corepack pnpm run typecheck && corepack pnpm -r --if-present run build",
    "build:api": "corepack pnpm --filter @workspace/api-server run build",
    "build:web": "corepack pnpm --filter @workspace/keep-tally run build",
    "ci": "corepack pnpm run typecheck && corepack pnpm run build:api && corepack pnpm run build:web",
    "db:check": "corepack pnpm --filter @workspace/db run check",
    "db:generate": "corepack pnpm --filter @workspace/db run generate",
    "db:migrate": "corepack pnpm --filter @workspace/db run migrate",
    "typecheck:api": "tsc -b lib/db lib/api-zod lib/integrations-openai-ai-server artifacts/api-server",
    "typecheck:web": "corepack pnpm --filter @workspace/keep-tally run typecheck",
    "typecheck:libs": "tsc --build",
    "typecheck:full": "tsc --build --force",
    "typecheck:bounded": "node scripts/typecheck-bounded.mjs",
    "typecheck:profile": "node scripts/typecheck-bounded.mjs --profile",
    "typecheck": "tsc --build"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.8.1",
    "tsx": "catalog:",
    "typescript": "~5.9.2",
    "vite": "7.3.2"
  }
}
